# vim: ft=sh
# Environment for uwsm sessions (all compositors); sourced by sh.
# Changes apply at the next login. HYPR* and AQ_* variables go in env-hyprland.
# See https://wiki.hypr.land/useful-utilities/uwsm/
# XDG base directories aren't set here: uwsm sets them itself.

# export XCURSOR_THEME=McMojave-cursors
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24

# Dark theme for GTK3 apps. GTK4/libadwaita apps use gsettings color-scheme instead.
export GTK_THEME=Adwaita:dark
