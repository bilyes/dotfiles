{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "session.timeline": "none",
    "session.delete": "none",
    "stash.delete": "none",
    "session.line.up": "ctrl+p",
    "session.line.down": "ctrl+n",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "<leader>g,home",
    "session.last": "<leader>shift+g,end"
  }
}
