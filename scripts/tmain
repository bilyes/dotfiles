#!/bin/sh

set -eu

# Detached sessions default to 80x24 and fastfetch prints only once, so start at the size it'll
# be shown at ('-' is the current client's)
if [ -n "${TMUX:-}" ]; then
  width=- height=- attach=switch-client
else
  width=$(tput cols) height=$(tput lines) attach=attach-session
fi

session=$(tmux new-session -d -P -F '#{session_id}' -x "$width" -y "$height")

# Even out the columns before splitting the left one: select-layout -E after it overflowed the
# window. Every command names the session: inside tmux, they'd act on the current one.
tmux send-keys -t "$session" 'btop' C-m \; \
  split-window -h -t "$session" \; \
  split-window -h -t "$session" \; \
  select-layout -t "$session" even-horizontal \; \
  split-window -v -t "$session:.1" \; \
  send-keys -t "$session" 'ff' C-m \; \
  select-pane -t "$session:.3"

exec tmux "$attach" -t "$session"
